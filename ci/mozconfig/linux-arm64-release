# Linux ARM64 release configuration for the AI2Apps-branded AceFox build.
# Firefox 143 bootstrap toolchain artifacts are no longer available, so this
# runner uses the system Clang, Rust, and WASI toolchains.
ac_add_options --disable-bootstrap

# Ubuntu 24.04 WASI libc++ is incompatible with Firefox 143 RLBox linking.
ac_add_options --without-wasm-sandboxed-libraries

# Release branding and optimization settings.
ac_add_options --with-branding=browser/branding/ai2apps
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Reuse the object directory between self-hosted runner jobs, while allowing
# Mozilla's build system to discard it automatically after incompatible changes.
mk_add_options AUTOCLOBBER=1
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-linux-arm64-release
